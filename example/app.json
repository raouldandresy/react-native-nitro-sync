{
  "expo": {
    "name": "Nitro Sync Example",
    "slug": "nitro-sync-example",
    "scheme": "nitrosync",
    "plugins": [
      [
        "react-native-nitro-sync",
        {
          "backgroundTaskIdentifier": "com.example.nitrosync"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a", "x86_64"]
          }
        }
      ],
      "expo-router",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "com.example.nitrosync"
    },
    "android": {
      "package": "com.example.nitrosync"
    }
  }
}
